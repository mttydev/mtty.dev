---
import { alternateFor, prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang?: Locale
}
const { lang = "en" } = Astro.props

const prefix = prefixFor(lang)
const links = [
  { href: `${prefix}/miao`, label: "miao", tone: "miao" },
  { href: `${prefix}/mtty`, label: "mtty", tone: "mtty" },
  { href: `${prefix}/docs/`, label: lang === "en" ? "Docs" : "文档", tone: "" },
]

// Trailing slashes vary between the marketing routes and Starlight's, so
// compare on a normalised path.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/"
const isCurrent = (href: string) => here === href.replace(/\/+$/, "")

const alternate = alternateFor(lang, Astro.url.pathname)
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={prefix || "/"} aria-label="mtty.dev">
      <img class="brand-mark" src="/miao/mark.png" width="26" height="26" alt="" />
      <span class="wordmark">mtty<em>.dev</em></span>
    </a>
    <nav aria-label={lang === "en" ? "Primary" : "主导航"}>
      {
        links.map((link) => (
          <a
            href={link.href}
            data-tone={link.tone || undefined}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="gh" href="https://github.com/mttydev" aria-label="GitHub">
        <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path></svg
        >
      </a>
      <a class="lang" href={alternate} hreflang={lang === "en" ? "zh-CN" : "en"}>
        {lang === "en" ? "中文" : "EN"}
      </a>
      <button
        class="theme"
        type="button"
        data-theme-toggle
        aria-label={lang === "en" ? "Switch light or dark theme" : "切换明暗主题"}
      >
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.2"
          ></circle>
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5Z" fill="currentColor"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px) saturate(1.2);
  }

  .bar {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    text-decoration: none;
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  :global(:root[data-theme="dark"]) .brand-mark {
    filter: invert(1);
  }

  .wordmark {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .wordmark em {
    color: var(--fg-faint);
    font-style: normal;
    font-weight: 400;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  nav a,
  .theme {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 11px;
    border-radius: 0;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 140ms ease, background 140ms ease;
  }

  nav a:hover,
  .theme:hover {
    color: var(--fg);
  }

  nav a[aria-current="page"] {
    color: var(--fg);
    box-shadow: inset 0 -1px 0 var(--fg);
  }

  nav a[data-tone="miao"] {
    font-family: var(--font-sans);
    text-transform: lowercase;
    letter-spacing: 0.04em;
    font-size: 0.86rem;
  }

  nav a[data-tone="mtty"] {
    font-family: var(--font-sans);
    text-transform: lowercase;
    letter-spacing: 0.04em;
    font-size: 0.86rem;
  }

  nav a[data-tone="miao"][aria-current="page"] {
    color: var(--miao-ink);
    box-shadow: inset 0 -1px 0 var(--miao-ink);
  }

  nav a[data-tone="mtty"][aria-current="page"] {
    color: var(--mtty-ink);
    box-shadow: inset 0 -1px 0 var(--mtty-ink);
  }

  .lang {
    margin-left: 8px;
    padding-left: 14px !important;
    border-left: 1px solid var(--border);
    font-size: 0.62rem;
  }

  .theme {
    border: 0;
    background: none;
    cursor: pointer;
    padding: 0 8px;
  }

  @media (max-width: 640px) {
    .bar {
      height: 60px;
      gap: 8px;
    }

    .gh {
      display: none !important;
    }

    nav {
      gap: 0;
      letter-spacing: 0.1em;
    }

    nav a,
    .theme {
      padding: 0 7px;
    }

    .lang {
      margin-left: 2px;
      padding-left: 8px !important;
    }
  }
</style>
