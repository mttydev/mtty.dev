---
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang?: Locale
  /**
   * The marketing page this footer sits under: "" for the home page, otherwise
   * the product slug. miao's attribution notice belongs on miao's own page — the home
   * page is the umbrella page for both products, not a miao page.
   */
  product?: string
}
const { lang = "en", product = "" } = Astro.props

const prefix = prefixFor(lang)
const en = lang === "en"
const year = new Date().getFullYear()

const columns = [
  {
    head: "miao",
    links: [
      { href: `${prefix}/miao`, label: en ? "Overview" : "概览" },
      { href: `${prefix}/docs/miao/guide/`, label: en ? "Guide" : "使用指南" },
      { href: "https://github.com/mttydev/miao/releases", label: en ? "Releases" : "版本发布" },
      { href: "https://github.com/mttydev/miao", label: "GitHub" },
    ],
  },
  {
    head: "mtty",
    links: [
      { href: `${prefix}/mtty`, label: en ? "Overview" : "概览" },
      { href: `${prefix}/docs/mtty/`, label: en ? "Documentation" : "文档" },
      {
        href: "https://github.com/mttydev/mtty/releases",
        label: en ? "Downloads" : "下载",
      },
      { href: "https://github.com/mttydev/mtty", label: "GitHub" },
    ],
  },
  {
    head: en ? "legal" : "法律",
    links: [
      { href: `${prefix}/docs/about/privacy/`, label: en ? "Privacy" : "隐私" },
      { href: `${prefix}/docs/about/license/`, label: en ? "License" : "许可" },
    ],
  },
]
---

<footer class="site-footer">
  <div class="inner">
    <div class="sign">
      <p class="mark">
        <img src="/miao/mark.png" width="42" height="42" alt="" />
        <span>mtty<span class="tld">.dev</span></span>
      </p>
      <p class="motto">
        {en ? "An agent and a terminal, both open source." : "一个代理，一个终端，都是开源的。"}
      </p>
    </div>
    {
      columns.map((column) => (
        <div class="col">
          <p class="head">{column.head}</p>
          {column.links.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      ))
    }
    <div class="contact">
      <p class="head">{en ? "contact" : "联系"}</p>
      <a href="mailto:contact@mtty.dev">contact@mtty.dev</a>
      {
        product === "miao" && (
          <p class="fork">
            {en ? (
              <>
                miao includes MIT-licensed code from{" "}
                <a href="https://github.com/anomalyco/opencode">opencode</a>. Thanks to its authors and contributors. See{" "}
                <a href={`${prefix}/docs/miao/attribution/`}>origins and licensing</a>.
              </>
            ) : (
              <>
                miao 包含来自 <a href="https://github.com/anomalyco/opencode">opencode</a>{" "}
                的 MIT 授权代码，感谢其作者与贡献者。详见
                <a href={`${prefix}/docs/miao/attribution/`}>项目来源与许可</a>。
              </>
            )}
          </p>
        )
      }
    </div>
  </div>
  <div class="inner">
    <div class="baseline">
      <span>© {year} mtty.dev</span>
      <span>miao · MIT &nbsp;/&nbsp; mtty · Apache-2.0</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    padding: 72px 0 30px;
    border-top: 1px solid #1d1d22;
    background: #08080a;
    color: #f4f4f0;
    font-size: 0.86rem;
  }

  .inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1.45fr 0.8fr 0.8fr 0.7fr 1.35fr;
    gap: 40px;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.4vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .mark img {
    width: 42px;
    height: 42px;
    object-fit: contain;
    filter: invert(1);
  }

  .tld {
    color: #6e6e68;
  }

  .motto {
    margin: 14px 0 0;
    max-width: 26ch;
    color: #8b8b84;
    line-height: 1.6;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .head {
    margin: 0 0 5px;
    color: #6e6e68;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  a {
    color: #a2a29c;
    text-decoration: none;
    transition: color 140ms ease;
  }

  a:hover {
    color: #f4f4f0;
  }

  /* miao's attribution notice, shown on miao's own page only: fine print under
     the contact line, divided like the baseline row. */
  .fork {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid #232328;
    color: #6e6e68;
    line-height: 1.65;
  }

  .fork a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .baseline {
    grid-column: 1 / -1;
    margin-top: 52px;
    padding-top: 20px;
    border-top: 1px solid #232328;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    color: #6e6e68;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Five columns need room; below that, the link columns pair up and the brand
     and contact blocks take a full row each. */
  @media (max-width: 1040px) {
    .inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }

    .sign {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .site-footer {
      padding-top: 56px;
    }

    .inner {
      grid-template-columns: 1fr 1fr;
    }

    .contact {
      grid-column: 1 / -1;
    }
  }
</style>
