---
// miao's mark: the hand-drawn line portrait, used as the brand glyph. It is
// black ink on transparency, so dark mode inverts the bitmap rather than
// shipping a second asset.
interface Props {
  size?: number
}
const { size = 32 } = Astro.props
---

<img
  class="miao-mark"
  src="/miao/mark.png"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
/>

<style>
  .miao-mark {
    display: block;
    flex: none;
    object-fit: contain;
  }

  :global(:root[data-theme="dark"]) .miao-mark {
    filter: invert(1);
  }
</style>
