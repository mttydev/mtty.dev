---
// The miao product page, in both languages. Claims follow the miao README and
// its comparison document: opt-in and experimental features say so, and the
// limits of the sandbox are stated next to the capability itself.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import InstallCommand from "../site/InstallCommand.astro"
import MiaoMark from "../site/MiaoMark.astro"
import ProductMedia from "../site/ProductMedia.astro"
import ShowcaseWindow from "../site/ShowcaseWindow.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const REPO = "https://github.com/mttydev/miao"

const copy = {
  en: {
    title: "miao — a coding agent for the terminal",
    description:
      "An open-source coding agent for the terminal. Lean context, visible cost, one-line install.",
    kind: "Coding agent",
    h1a: "Lean",
    h1b: "context",
    h1c: "lower",
    h1d: "cost",
    lede: "Reads the repo, makes the change, runs the checks, returns the result. Lean context; cost recorded per turn.",
    sub: "Budgets over money, tokens, turns and time.",
    installHead: "Install miao",
    pillarsLabel: "the essentials",
    pillars: [
      ["Context", "A fixed baseline, changes appended in order, so prompt caches keep hitting."],
      ["Cost", "Tokens, cache and estimated cost per turn. Budgets by money, turns and time."],
      ["Install", "One binary. No engine, no second TUI. One command for macOS, Linux and Windows."],
    ],
    copyLabel: "Copy command",
    platforms: "Single binary · macOS, Linux and Windows · MIT",
    guide: "Read the guide",
    faq: "FAQ",
    whyPage: "Why miao?",
    comparisonPage: "Compare eight agent workflows",
    source: "Source",
    shot: "Current miao terminal UI showing an example code review, an inline edit diff, the response and context telemetry.",
    cap: "Build agent · inline code changes and context telemetry · illustrative session",
    steerLabel: "steering",
    steerH: "Add a requirement while it runs.",
    steerBody: [
      "A new input is saved, then folded in at a safe turn boundary; the running call is not interrupted.",
      "Explicitly queued inputs wait for idle; promoting a new input resets the turn allowance.",
    ],
    t1: "Find the cause of this failing test, fix it, run the relevant checks, and explain the diff.",
    tWork: "working",
    t2: "Preserve the public API and avoid new runtime dependencies.",
    tSteer: "steer · saved, folds in at the next turn boundary",
    tQueue: "queue · waits until the session would go idle",
    t3: "Then prepare a draft pull request description.",
    whyLabel: "why miao",
    whyH: "Mechanism",
    why: [
      ["Context", "The baseline stays fixed and changes are appended in order, so prompt caches keep hitting. Cache policy and TTL are configurable per provider."],
      ["Compaction", "Starts near the threshold; the summary reuses the current prefix. Old output is pruned; oversized results stay on disk and remain recallable."],
      ["Cost", "Tokens, cache-hit rate, time to first token and estimated cost per turn. Warn at four fifths of budget, stop at the next safe boundary."],
      ["Install", "One binary, no engine or TUI. One command for macOS, Linux and Windows."],
    ],
    costNote: "Costs are estimates; the provider bill is authoritative. Saved history does not resume work after a crash; an unfinished turn needs an explicit resume.",
    dailyLabel: "everyday engineering",
    dailyH: "Everyday work.",
    dailyHead: ["What you need", "What miao provides"],
    daily: [
      ["Understand an unfamiliar repository", "File reading, search, project instructions, skills and specialist subagents"],
      ["Implement and verify a change", "File edits and patches, shell commands, optional LSP diagnostics and formatting"],
      ["Compare models without changing tools", "In-session model selection, provider configuration, per-agent models and reasoning variants where supported"],
      ["Work through a larger task", "Todos, mid-task input, durable sessions and an opt-in autonomous continuation loop"],
      ["Connect your own tools", "Local and remote MCP servers, custom commands, skills and plugins"],
      ["Review and reuse work", "Diffs, session forks, history export and permission prompts"],
      ["Integrate with another application", "HTTP server, browser UI, CLI automation, and generated clients in the workspace"],
    ],
    screensLabel: "the app",
    screensH: "Runs in the terminal.",
    screens: [
      ["/shots/miao-session.mp4", "Review the work, choose the model", "An illustrative code-review session with an inline diff and context telemetry; open model selection without leaving the conversation."],
      ["/shots/miao-providers.mp4", "Bring your own provider", "Browse the provider picker and its available services. Connect OpenAI, Anthropic, GitHub Copilot, Google or your own endpoint."],
      ["/shots/miao-web.mp4", "The same session, in a browser", "Expand the edit diff and open the file-review panel in miao's browser UI. This is the same illustrative session as the terminal capture."],
      ["/shots/miao-mini.mp4", "A compact interactive mode", "The development build's opt-in mini interface: task progress, an edit diff and a multi-select question, using the built-in demo mode."],
      ["/shots/miao-permission.webp", "Review before allowing an edit", "The mini interface's edit-permission prompt shows the proposed diff and Allow once, Allow always and Reject choices. Built-in demo mode."],
      ["/shots/miao-home.webp", "Start with a prompt", "The current terminal start screen, with the selected agent, model and reasoning variant beside the input."],
    ],
    loopLabel: "longer tasks",
    loopH: "Long tasks.",
    loopBody: "Autonomous continuation is opt-in, bounded by an iteration cap and stall detection. At the cost threshold, no new provider turn is scheduled.",
    loopFine: "The budget is not a hard cap on a provider bill or on a turn already in flight. Put this in .miao/miao.jsonc for one project, or ~/.config/miao/miao.jsonc for all of them.",
    sandboxLabel: "isolation",
    sandboxH: "Command sandbox.",
    sandboxBody: "The Rust layer handles two things: kernel-level isolation around bash, and the matching and patch paths behind edit and apply_patch.",
    sandboxRows: [
      [
        "Kernel isolation",
        "macOS seatbelt and Linux Landlock restrict writes to the active Location, the command directory and approved paths.",
      ],
      [
        "Intercept and approve",
        "A blocked write reports the required path and stops. Approving the directory reruns the command with access.",
      ],
      [
        "Default on",
        "Native matching and patches run through the addon; MIAO_NATIVE=0 hands them to TypeScript.",
      ],
    ],
    sandboxFine: "The sandbox is opt-in and off by default, and Windows has no backend yet. It fails open: a requested sandbox whose backend is unavailable warns and runs the command unsandboxed unless on_unavailable is set to \"fail\".",
    statusLabel: "status",
    statusH: "Before 1.0: capabilities and limits.",
    statusHead: ["Capability", "Availability"],
    status: [
      ["Saved sessions, mid-task input and project-local session messaging", "Implemented", "ok"],
      ["Autonomous continuation and cost budgets", "Opt-in", "opt"],
      ["Old tool-output pruning and automatic compaction", "On by default · configurable", "ok"],
      ["Code Mode", "Experimental", ""],
      ["Kernel sandbox for bash; native accelerators in edit and apply_patch", "Sandbox opt-in · accelerators default", "opt"],
      ["Generated clients and the embedded host", "Evolving API", ""],
    ],
    startLabel: "quick start",
    startH: "Three commands to a first session.",
    startFine: "Inside the TUI, <kbd>ctrl+p</kbd> opens the command palette and <kbd>ctrl+x m</kbd> picks a model. <code>miao models</code> lists what is available.",
    c1: "choose a provider, connect an account or API key",
    c2: "start the terminal UI",
    c3: "one-shot, without the TUI",
    c4: "the browser interface",
    c5: "update the release binary",
    endH: "Your models. Your terminal.",
    docs: "Documentation",
    releases: "Releases",
  },
  zh: {
    title: "miao — 终端编码代理",
    description:
      "开源的终端编码代理。上下文精简，费用可见，一行安装。",
    kind: "编码代理",
    h1a: "Lean",
    h1b: "context",
    h1c: "lower",
    h1d: "cost",
    lede: "读仓库、改代码、运行检查，结果交由你确认。上下文精简，费用逐轮记录。",
    sub: "预算按金额、token、轮次与时长设定。",
    installHead: "安装 miao",
    pillarsLabel: "要点",
    pillars: [
      ["上下文", "基线固定，变化按序追加，提示缓存跨轮命中。"],
      ["费用", "逐轮记录 token、缓存与估算费用；预算按金额、轮次与时长设定。"],
      ["安装", "单个二进制，无引擎、无第二套 TUI。一行覆盖 macOS、Linux、Windows。"],
    ],
    copyLabel: "复制命令",
    platforms: "单个二进制 · macOS、Linux 与 Windows · MIT",
    guide: "阅读使用指南",
    faq: "常见问题",
    whyPage: "为什么是 miao",
    comparisonPage: "八个开源代理对比",
    source: "源码",
    shot: "当前 miao 终端界面：示例代码审阅、行内编辑 diff、回复和上下文用量。",
    cap: "Build 代理 · 行内代码改动与上下文用量 · 示例会话",
    steerLabel: "中途改要求",
    steerH: "任务进行中，可补充要求。",
    steerBody: [
      "新输入先持久化，至安全边界并入会话；正在执行的调用不中断。",
      "显式排队的输入待会话空闲处理；新输入被采纳后，轮次额度重新计算。",
    ],
    t1: "定位此测试失败的原因，完成修复，运行相关检查，并解释代码差异。",
    tWork: "进行中",
    t2: "保持公共 API 不变，不引入新的运行时依赖。",
    tSteer: "steer · 已保存，在下一个轮次边界并入",
    tQueue: "queue · 等会话即将空闲时再处理",
    t3: "随后准备一份草稿 PR 描述。",
    whyLabel: "为什么是 miao",
    whyH: "机制",
    why: [
      ["上下文", "基线固定，变化按序追加，提示缓存跨轮命中。缓存策略与 TTL 可按供应商配置。"],
      ["压缩", "接近阈值时开始，摘要复用当前前缀。旧输出默认裁剪；超大结果留存磁盘，仍可召回。"],
      ["费用", "逐轮记录 token、缓存命中率、首 token 延迟与估算费用。预算用至五分之四时提醒，到限即停。"],
      ["安装", "单个二进制，无引擎或 TUI。一行覆盖 macOS、Linux、Windows。"],
    ],
    costNote: "费用为估算值，以供应商账单为准。历史保存不等于崩溃续跑；未完成的轮次需显式恢复。",
    dailyLabel: "日常工程",
    dailyH: "日常工作。",
    dailyHead: ["工程需求", "miao 的能力"],
    daily: [
      ["理解陌生仓库", "文件读取、搜索、项目指令、技能、专项子代理"],
      ["实现功能并验证", "文件编辑与补丁、Shell 命令、可选 LSP 诊断和格式化"],
      ["比较模型而不换工具", "会话内模型切换、自定义供应商、按代理配置模型、受支持模型的推理档位"],
      ["推进较大的任务", "待办、中途补充要求、持久化会话、可选自治续跑"],
      ["接入自己的工具", "本地与远程 MCP、自定义命令、技能、插件"],
      ["检查并复用工作成果", "差异查看、会话分叉、历史导出、权限确认"],
      ["接入其他应用", "HTTP 服务、浏览器界面、CLI 自动化、工作区内生成的客户端"],
    ],
    screensLabel: "界面",
    screensH: "终端内运行。",
    screens: [
      ["/shots/miao-session.mp4", "审阅改动，选择模型", "示例代码审阅会话中直接查看 diff 和上下文用量；打开模型选择，不用离开当前会话。"],
      ["/shots/miao-providers.mp4", "自带模型服务商", "打开供应商选择器，浏览可用服务；连接 OpenAI、Anthropic、GitHub Copilot、Google 或自己的端点。"],
      ["/shots/miao-web.mp4", "同一个会话，也能在浏览器里看", "在 miao 浏览器界面展开编辑 diff、打开文件审阅面板；与终端截图使用同一个示例会话。"],
      ["/shots/miao-mini.mp4", "紧凑的交互模式", "开发构建中可选的 mini 界面：任务进度、编辑 diff 和多选问题，使用内置演示模式录制。"],
      ["/shots/miao-permission.webp", "允许编辑前，先看清改动", "mini 界面的编辑权限确认展示拟议 diff，以及单次允许、始终允许和拒绝选项。来自内置演示模式。"],
      ["/shots/miao-home.webp", "从一个提示开始", "当前终端启动界面，输入框旁直接显示所选代理、模型和推理档位。"],
    ],
    loopLabel: "续跑",
    loopH: "长任务。",
    loopBody: "自治续跑需手动开启，受迭代上限与停滞检测约束。费用达到阈值后，不再调度新的模型轮次。",
    loopFine: "预算不是供应商账单的硬上限，也不会中止已经发出的那一轮。项目级配置放在 .miao/miao.jsonc，全局配置放在 ~/.config/miao/miao.jsonc。",
    sandboxLabel: "隔离",
    sandboxH: "命令沙箱。",
    sandboxBody: "Rust 层仅处理两件事：bash 的内核级隔离，以及 edit 与 apply_patch 的匹配与补丁。",
    sandboxRows: [
      [
        "内核隔离",
        "macOS seatbelt 与 Linux Landlock 限制写入范围：当前 Location、命令目录与已批准路径。",
      ],
      [
        "拦截与批准",
        "写入被拦时报告所需路径并停止；批准目录后，命令带权限重跑。",
      ],
      [
        "默认启用",
        "原生匹配与补丁经 addon 运行；MIAO_NATIVE=0 关闭，由 TypeScript 接管。",
      ],
    ],
    sandboxFine: "沙箱默认关闭，需手动开启；Windows 尚无后端。无后端时默认放行，除非 on_unavailable 设为 \"fail\"。",
    statusLabel: "现状",
    statusH: "1.0 之前：能力与限制。",
    statusHead: ["能力", "可用性"],
    status: [
      ["会话保存、中途输入与项目内会话消息", "已实现", "ok"],
      ["自治续跑与费用预算", "可选开启", "opt"],
      ["旧工具输出裁剪与自动压缩", "默认开启 · 可配置", "ok"],
      ["Code Mode", "实验性", ""],
      ["bash 的内核级沙箱；edit 与 apply_patch 的原生加速", "沙箱需开启 · 加速默认启用", "opt"],
      ["生成的客户端与嵌入式宿主", "API 仍在演进", ""],
    ],
    startLabel: "快速开始",
    startH: "三条命令，开始第一个会话。",
    startFine: "在 TUI 内用 <kbd>ctrl+p</kbd> 打开命令面板，用 <kbd>ctrl+x m</kbd> 选择模型。<code>miao models</code> 可以列出可用模型。",
    c1: "选择供应商，连接账户或 API Key",
    c2: "启动终端界面",
    c3: "一次性执行，不进 TUI",
    c4: "打开浏览器界面",
    c5: "更新正式版",
