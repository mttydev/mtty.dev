---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="masthead">
    <p class="kicker rise" style="--i:0"><MiaoMark size={18} /><b>miao</b> · {copy.kind}</p>
    <h1 class="slogan" aria-label={`${copy.h1a} ${copy.h1b} ${copy.h1c} ${copy.h1d}`}>
      <span class="hl" style="--line:0" aria-hidden="true">
        <span><b>{copy.h1a}</b> {copy.h1b}</span>
      </span>
      <span class="hl" style="--line:1" aria-hidden="true">
        <span><i>{copy.h1c}</i> {copy.h1d}</span>
      </span>
    </h1>
    <p class="masthead-lede rise" style="--i:3">{copy.lede}</p>
    <div class="masthead-actions rise" style="--i:4">
      <a class="btn solid" href="#install">{copy.installHead}</a>
      <a class="btn" href={`${prefix}/docs/miao/guide/`}>{copy.guide} <span class="arrow">→</span></a>
    </div>
  </section>

  <figure class="campaign" data-reveal>
    <ProductMedia src="/shots/miao.webp" alt={copy.shot} eager sizes="100vw" />
    <figcaption>{copy.cap}</figcaption>
  </figure>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.pillarsLabel}</p>
    </header>
    <ol class="pillars">
      {
        copy.pillars.map(([head, body]) => (
          <li>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap chapter steer" data-reveal>
    <div class="steer-copy">
      <p class="eyebrow">{copy.steerLabel}</p>
      <h2 class="chapter-title">{copy.steerH}</h2>
      {copy.steerBody.map((paragraph) => <p class="lede">{paragraph}</p>)}
    </div>
    <ol class="transcript panel" aria-label={copy.steerLabel}>
      <li class="msg">
        <span class="who">›</span>
        <p>{copy.t1}</p>
      </li>
      <li class="work" aria-hidden="true">
        <span class="spin"></span>
        <span>{copy.tWork}</span>
        <span class="tools">read · grep · edit · bash</span>
      </li>
      <li class="msg steered">
        <span class="who">›</span>
        <div>
          <p>{copy.t2}</p>
          <span class="chip s">{copy.tSteer}</span>
        </div>
      </li>
      <li class="msg queued">
        <span class="who">›</span>
        <div>
          <p>{copy.t3}</p>
          <span class="chip q">{copy.tQueue}</span>
        </div>
      </li>
    </ol>
  </section>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.whyLabel}</p>
      <h2 class="chapter-title">{copy.whyH}</h2>
    </header>
    <ol class="why">
      {
        copy.why.map(([head, body], index) => (
          <li>
            <span class="n">0{index + 1}</span>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
    <p class="fine note">{copy.costNote}</p>
    <div class="actions">
      <a class="btn" href={`${prefix}/docs/miao/why-miao/`}>{copy.whyPage} <span class="arrow">→</span></a>
      <a class="btn" href={`${prefix}/docs/miao/comparison/`}>{copy.comparisonPage} <span class="arrow">→</span></a>
    </div>
  </section>

  <section class="wrap chapter split" data-reveal>
    <header class="chapter-head start sticky">
      <p class="eyebrow">{copy.dailyLabel}</p>
      <h2 class="chapter-title">{copy.dailyH}</h2>
    </header>
    <table class="spec">
      <thead>
        <tr><th>{copy.dailyHead[0]}</th><td>{copy.dailyHead[1]}</td></tr>
      </thead>
      <tbody>
        {
          copy.daily.map(([need, provides]) => (
            <tr>
              <th>{need}</th>
              <td>{provides}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section id="screens" class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.screensLabel}</p>
      <h2 class="chapter-title">{copy.screensH}</h2>
    </header>
    <div class="shotgrid">
      {
        copy.screens.map(([src, head, body]) => (
          <figure class="scard">
            <ProductMedia src={src} alt={body} />
            <figcaption>
              <b>{head}</b>
              <span>{body}</span>
              <a class="media-original" href={src} target="_blank" rel="noopener noreferrer">{lang === "zh" ? "放大查看" : "View full size"} ↗</a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="wrap chapter loop" data-reveal>
    <div>
      <p class="eyebrow">{copy.loopLabel}</p>
      <h2 class="chapter-title">{copy.loopH}</h2>
      <p class="lede">{copy.loopBody}</p>
      <p class="fine">{copy.loopFine}</p>
    </div>
    <pre class="codeblock"><code><span class="c">// .miao/miao.jsonc</span>
{"{"}
  <span class="k">"loop"</span>: {"{"} <span class="k">"enabled"</span>: <span class="s">true</span>, <span class="k">"max_iterations"</span>: <span class="s">25</span> {"}"},
  <span class="k">"cost"</span>: {"{"} <span class="k">"budget_usd"</span>: <span class="s">5</span> {"}"},
  <span class="k">"compaction"</span>: {"{"} <span class="k">"prune"</span>: <span class="s">true</span> {"}"},
{"}"}</code></pre>
  </section>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.sandboxLabel}</p>
      <h2 class="chapter-title">{copy.sandboxH}</h2>
      <p class="chapter-lede">{copy.sandboxBody}</p>
    </header>
    <div class="sandbox">
      {
        copy.sandboxRows.map((row) => (
          <div class="sandbox-row">
            <b>{row[0]}</b>
            <p>{row[1]}</p>
          </div>
        ))
      }
    </div>
    <p class="fine note">{copy.sandboxFine}</p>
  </section>

  <section class="wrap chapter split" data-reveal>
    <header class="chapter-head start sticky">
      <p class="eyebrow">{copy.statusLabel}</p>
      <h2 class="chapter-title">{copy.statusH}</h2>
    </header>
    <table class="spec">
      <thead>
        <tr><th>{copy.statusHead[0]}</th><td>{copy.statusHead[1]}</td></tr>
      </thead>
      <tbody>
        {
          copy.status.map(([capability, availability, tone]) => (
            <tr>
              <th class="cap">{capability}</th>
              <td><span class:list={["tag", tone]}>{availability}</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="wrap chapter start" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.startLabel}</p>
      <h2 class="chapter-title">{copy.startH}</h2>
    </header>
    <pre class="codeblock"><code><span class="p">$ </span>curl -fsSL https://mtty.dev/miao/install | bash        <span class="c"># macOS / Linux</span>
<span class="p">PS> </span>irm https://mtty.dev/miao/install.ps1 | iex        <span class="c"># Windows</span>
