    mttyBlurb: "以 Rust 编写的 AI 原生终端与编辑器：终端、文件、远程主机与代理同处一个窗口，并可识别代理正在执行、等待确认或已经完成。",
    installHead: "安装 miao",
    installMeta: "macOS · Linux · Windows",
    downloadHead: "获取 mtty",
    download: "下载预览版",
    downloadMeta: "macOS · Linux · Windows · 预览版",
    copyLabel: "复制命令",
    shotMtty: "当前 mtty 示例工作区：会话侧栏、Markdown 编辑器、Mermaid 预览和分屏终端。",
    shotMiao: "当前 miao 示例会话：行内编辑 diff、回复和上下文遥测。",
    capMtty: "mtty · 编辑、预览、终端和 Agent 状态",
    capMiao: "miao · 任务、改动、工具与上下文（示例会话）",
    productsLabel: "两个产品",
    productsH: "两个彼此独立的项目。",
    miaoKind: "AI 智能体",
    miaoH: "少一点冗余，多一点从容。",
    miaoPoints: [
      ["上下文只留必要", "系统上下文基线保持不变，变化按时间顺序引入，供应商可跨轮持续命中提示缓存。"],
      ["在成本上升之前压缩", "压缩在窗口填满之前开始，摘要复用当前请求前缀；旧工具输出默认裁剪，完整结果保留在磁盘。"],
      ["每一轮都有据可查", "逐轮 token、缓存命中率、首 token 延迟与估算费用，并可按金额、token、轮次与时长设定预算。"],
      ["开始只需一行", "安装器仅写入 miao，无需额外的引擎或 TUI；同一条命令覆盖 macOS、Linux 与 Windows。"],
    ],
    miaoMeta: "单二进制 · Rust 加速 · MIT",
    miaoMore: "了解 miao",
    mttyKind: "终端 · 编辑器 · 代理",
    mttyH: "终端、编辑器与代理，同在一个原生窗口。",
    mttyPoints: [
      ["GPU 渲染", "损伤驱动重绘，减少无效工作，并由实测性能预算把关。"],
      ["是工作台，不只是窗口", "标签、递归分屏、快速文件导航，以及带高亮、语言服务器和实时预览的原生编辑器窗格。"],
      ["懂得代理", "窗格徽章、系统通知、防休眠与提示队列，都由代理状态驱动。"],
      ["远程主机像本地目录", "主机库、密钥、SFTP、端口转发、跳板机与命令片段，经由你自己的 OpenSSH。"],
    ],
    mttyMeta: "Rust · Apache-2.0 · 预发布",
    mttyMore: "了解 mtty",
    togetherLabel: "配合使用",
    togetherH: "四个代理同时运行，无需逐一查看。",
    togetherLede:
      "在 mtty 的窗格中，miao 通过终端的控制面上报状态。mtty 据此为窗格添加徽章，在代理需要确认时发出通知，在代理执行期间阻止电脑休眠，并在其空闲时发出排队的提示。",
    togetherFine:
      "二者互不依赖。离开 mtty 时，状态上报不产生任何操作；没有代理上报时，mtty 仍是一个独立的终端。mtty 也为其他代理 CLI 提供状态钩子。",
    states: [
      ["api", "processing", "正在推进待办清单"],
      ["web", "awaiting", "请求执行命令的权限"],
      ["docs", "idle", "已完成 —— 下一条排队提示即将发出"],
      ["migrate", "error", "模型服务返回了错误"],
    ],
    illus: "示意：mtty 能识别的四种代理状态",
    flow: ["miao", "代理状态", "mtty 窗格"],
    shotsLabel: "看图",
    shotsH: "终端、编辑器与代理，同在一个窗口。",
    shots: [
      ["/shots/miao-session.mp4", "miao · 审阅改动，再选模型", "示例会话展示编辑 diff 和上下文遥测；模型选择也留在同一个会话中。"],
      ["/shots/mtty-states.mp4", "mtty · 代理状态，实时变化", "控制面事件让标签徽章和 Agent 面板依次显示 processing、awaiting、error 与 idle。"],
      ["/shots/miao-providers.mp4", "miao · 自带模型服务商", "打开供应商选择器，浏览并选择适合任务的服务。"],
      ["/shots/mtty-editor.mp4", "mtty · 编辑器与实时预览", "Markdown 改动同步更新旁边的预览，包含 Mermaid、表格与代码块。"],
      ["/shots/miao-web.mp4", "miao · 浏览器工作区", "在浏览器里展开代码 diff、打开审阅面板，使用同一个示例会话。"],
      ["/shots/mtty-review.mp4", "mtty · 行内改动审阅", "在编辑器里审阅拟议改动，再通过命令面板接受。"],
      ["/shots/mtty-hosts.webp", "mtty · 本地与远程", "分组主机库提供文件入口和已保存的端口转发；展示地址均为示例。"],
      ["/shots/mtty-splits.webp", "mtty · 递归分屏", "Git 改动与实际运行的本地 HTTP 服务并排，共用一个工作区。"],
    ],
    honestLabel: "现状",
    honestH: "早期，但边界清楚。",
    honest: [
      ["1.0 之前", "两个项目发布频繁，版本之间可能存在变化。发布说明见 GitHub。"],
      ["文档源自源码", "两个产品的使用文档均从对应仓库同步，每篇同步页面注明来源提交。"],
      ["陈述均附边界", "基准测试说明其测量对象；可选或实验性能力均会明确标注。"],
    ],
    endH: "从一行命令开始。",
    docs: "阅读文档",
  },
}[lang]
---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="wrap hero-head">
      <div class="hero-topline rise">
        <span><MiaoMark size={15} /> miao</span>
        <span>{copy.kicker}</span>
        <span>OPEN SOURCE · MIT</span>
      </div>

      <h1 class="display h1 rise" style="--i:1">
        <span class="hl">{copy.h1a}</span>
        <span class="hl">{copy.h1b}</span>
        <em class="hl accent">{copy.h1c}</em>
      </h1>

      <div class="hero-intro rise" style="--i:2">
        <p class="lede">{copy.heroLede}</p>
        <div class="hero-install">
          <p class="install-caption">{copy.installHead} · {copy.installMeta}</p>
          <InstallCommand id="install-hero" label={copy.copyLabel} />
        </div>
      </div>
    </div>

    <ol class="wrap hero-features rise" style="--i:3">
      {
        copy.pillars.map(([head, body], index) => (
          <li>
            <span class="n">0{index + 1}</span>
            <h2 class="pillar-head">{head}</h2>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>

    <div class="hero-stage rise" style="--i:4">
      <ProductShowcase lang={lang} miaoKind={copy.miaoKind} mttyKind={copy.mttyKind}>
          <ShowcaseWindow slot="miao" embedded product="miao" kind={copy.miaoKind} lang={lang} slides={[
            { src: "/shots/miao.webp", label: lang === "zh" ? "行内代码改动与上下文遥测 · 示例会话" : "Inline code changes and context telemetry · Example session", alt: copy.shotMiao },
            { src: "/shots/miao-providers.webp", label: lang === "zh" ? "连接你选择的模型服务" : "Connect your choice of model provider", alt: lang === "zh" ? "miao 模型服务选择面板" : "miao model provider selection" },
            { src: "/shots/miao-home.webp", label: lang === "zh" ? "从一个提示开始" : "Start with a prompt", alt: lang === "zh" ? "miao 启动界面和提示输入框" : "miao start screen and prompt input" },
          ]} />
          <ShowcaseWindow slot="mtty" embedded product="mtty" kind={copy.mttyKind} lang={lang} slides={[
            { src: "/shots/mtty.webp", label: lang === "zh" ? "编辑器、预览与终端" : "Editor, preview and terminal", alt: copy.shotMtty },
            { src: "/shots/mtty-editor.webp", label: lang === "zh" ? "Markdown 与 Mermaid 实时预览" : "Live Markdown and Mermaid preview", alt: lang === "zh" ? "mtty Markdown 编辑器和实时预览" : "mtty Markdown editor with live preview" },
            { src: "/shots/mtty-splits.webp", label: lang === "zh" ? "并排查看终端与运行中的服务" : "Terminals and running services side by side", alt: lang === "zh" ? "mtty 递归分屏终端" : "mtty split terminals" },
          ]} />
      </ProductShowcase>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>01</b> {copy.productsLabel}</p>
      <h2 class="display h2">{copy.productsH}</h2>
    </div>
    <div class="duo">
      <a class="card c-miao" href={`${prefix}/miao`}>
        <div class="card-top">
          <MiaoMark size={40} />
          <div>
            <span class="card-name">miao</span>
            <span class="card-kind">{copy.miaoKind}</span>
          </div>
        </div>
        <h3 class="display h3">{copy.miaoH}</h3>
        <dl class="points">
          {
            copy.miaoPoints.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="card-foot">
          <span class="card-meta">{copy.miaoMeta}</span>
          <span class="more">{copy.miaoMore} <span class="arrow">→</span></span>
        </div>
      </a>
      <a class="card c-mtty" href={`${prefix}/mtty`}>
        <div class="card-top">
          <MttyMark size={40} />
          <div>
            <span class="card-name">mtty</span>
            <span class="card-kind">{copy.mttyKind}</span>
          </div>
        </div>
        <h3 class="display h3">{copy.mttyH}</h3>
        <dl class="points">
          {
            copy.mttyPoints.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="card-foot">
          <span class="card-meta">{copy.mttyMeta}</span>
          <span class="more">{copy.mttyMore} <span class="arrow">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <section class="wrap section together" data-reveal>
    <div class="together-copy">
      <p class="label"><b>02</b> {copy.togetherLabel}</p>
      <h2 class="display h2">{copy.togetherH}</h2>
      <p class="lede">{copy.togetherLede}</p>
      <p class="fine">{copy.togetherFine}</p>
    </div>
    <div class="board panel" role="img" aria-label={copy.illus}>
      <div class="board-bar" aria-hidden="true">
        <MttyMark size={16} />
        <span>mtty</span>
      </div>
      <ul class="panes" aria-hidden="true">
        {
          copy.states.map(([name, state, note]) => (
            <li data-state={state}>
              <span class="badge" />
              <span class="pane-name">{name}</span>
              <span class="pane-state">{state}</span>
              <span class="pane-note">{note}</span>
            </li>
          ))
        }
      </ul>
      <div class="wire" aria-hidden="true">
        <span class="node n-miao">{copy.flow[0]}</span>
        <span class="line"><span class="pulse"></span></span>
        <span class="node">{copy.flow[1]}</span>
        <span class="line"><span class="pulse"></span></span>
        <span class="node n-mtty">{copy.flow[2]}</span>
      </div>
      <code class="board-cmd" aria-hidden="true"
        >mtty-cli state miao --state awaiting --pane $MTTY_PANE_ID</code
      >
    </div>
  </section>

  <section class="wrap section shots" data-reveal>
    <div class="section-head">
      <p class="label"><b>03</b> {copy.shotsLabel}</p>
      <h2 class="display h2">{copy.shotsH}</h2>
    </div>
    <div class="shotgrid">
      {
        copy.shots.map(([src, head, body]) => (
          <figure class="scard">
            <ProductMedia src={src} alt={body} />
            <figcaption>
              <b>{head}</b>
              <span>{body}</span>
              <a class="media-original" href={src} target="_blank" rel="noopener noreferrer">{lang === "zh" ? "放大查看" : "View full size"} ↗</a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>04</b> {copy.honestLabel}</p>
      <h2 class="display h2">{copy.honestH}</h2>
    </div>
    <ol class="honest">
      {
        copy.honest.map(([head, body], index) => (
          <li>
            <span class="n">0{index + 1}</span>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section end" data-reveal>
    <h2 class="display h2">{copy.endH}</h2>
    <InstallCommand id="install-end" label={copy.copyLabel} />
    <div class="actions">
      <a class="btn" href={`${prefix}/docs/`}>{copy.docs} <span class="arrow">→</span></a>
      <a class="btn" href={RELEASES}>{copy.download} <span class="arrow">→</span></a>
    </div>
  </section>
</MarketingLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: 56px;
  }

  .g1 {
    width: 720px;
    height: 520px;
    left: -180px;
    top: -200px;
    background: var(--miao-1);
  }

  .g2 {
    width: 680px;
    height: 520px;
    right: -220px;
    top: 380px;
    background: var(--mtty-accent);
  }

  /* Keep the introduction, actions and both workspaces together above the fold. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: 48px;
    align-items: center;
    padding-bottom: 8px;
  }

  .h1 {
    margin-top: 4px;
    font-size: clamp(2.1rem, 3.1vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
  }

  .h1 .hl {
    display: block;
  }

  :lang(zh-CN) .h1 {
    font-size: clamp(1.9rem, 2.9vw, 2.7rem);
    line-height: 1.28;
  }

  .picks {
    display: grid;
    gap: 28px;
    margin-top: 36px;
  }

  .pick {
    display: grid;
    gap: 10px;
    min-width: 0;
