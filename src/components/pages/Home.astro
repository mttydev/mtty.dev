---
// The home page, in both languages. The copy for each language sits side by
// side so a change to one is visibly a change to the other.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import InstallCommand from "../site/InstallCommand.astro"
import MiaoMark from "../site/MiaoMark.astro"
import MttyMark from "../site/MttyMark.astro"
import ShowcaseWindow from "../site/ShowcaseWindow.astro"
import ProductShowcase from "../site/ProductShowcase.astro"
import ProductMedia from "../site/ProductMedia.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const RELEASES = "https://github.com/mttydev/mtty/releases/latest"

const copy = {
  en: {
    title: "miao — an open-source coding agent for the terminal",
    description:
      "miao is an open-source coding agent for the terminal. It reads the repo, makes the change, runs the checks, and keeps the cost of every turn in view.",
    kicker: "An open-source coding agent for the terminal",
    h1a: "It reads your repo,",
    h1b: "makes the change,",
    h1c: "then waits for you.",
    heroLede:
      "The diff and the bill for every turn stay in view. Installing takes one line.",
    pillars: [
      [
        "Context that stays lean",
        "The system-context baseline stays fixed and changes are appended in order, so the provider cache keeps hitting. Compaction starts before the window fills and reuses the current request prefix; old tool output is pruned by default.",
