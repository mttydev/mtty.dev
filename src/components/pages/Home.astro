    downloadHead: "Get mtty",
    download: "Download the preview",
    downloadMeta: "macOS · Linux · Windows · preview",
    copyLabel: "Copy command",
    shotMtty: "Current mtty example workspace with a session sidebar, Markdown editor, Mermaid preview and a split terminal.",
    shotMiao: "Current miao example session with an inline edit diff, response and context telemetry.",
    capMtty: "mtty · editor, preview, terminal and agent state",
    capMiao: "miao · tasks, changes, tools and context (example session)",
    productsLabel: "the products",
    productsH: "Two independent projects.",
    miaoKind: "AI agent",
    miaoH: "Less noise, more composure.",
    miaoPoints: [
      ["Context, only what matters", "The system-context baseline stays fixed and changes enter chronologically, so a provider can keep hitting its prompt cache across turns."],
      ["Compact before cost rises", "Compaction begins before the window fills and its summary reuses the current request prefix; old tool output is pruned by default, with full results kept on disk."],
      ["Every turn, accounted for", "Per-turn tokens, cache-hit rate, time to first token and estimated cost, with budgets over cost, tokens, turns and time."],
      ["One line to begin", "The installer writes only miao, with no separate engine or TUI; one command covers macOS, Linux and Windows."],
    ],
    miaoMeta: "Single binary · Rust accelerators · MIT",
    miaoMore: "Explore miao",
    mttyKind: "Terminal · editor · agents",
    mttyH: "Terminal, editor and agents in one native window.",
    mttyPoints: [
      ["Rendered on the GPU", "Smooth terminal rendering with damage-driven redraws and measured performance budgets."],
      ["A workspace, not just a window", "Tabs, recursive splits, quick file navigation and native editor panes with syntax highlighting, language servers and live previews."],
      ["Aware of agents", "Pane badges, notifications, a sleep guard and a prompt queue driven by agent state."],
      ["Remote hosts like local folders", "A host library, keys, SFTP, port forwarding, jump hosts and snippets over your own OpenSSH."],
    ],
    mttyMeta: "Rust · Apache-2.0 · pre-release",
    mttyMore: "Explore mtty",
    togetherLabel: "better together",
    togetherH: "Four agents at once, none of them watched.",
    togetherLede:
      "Inside an mtty pane, miao reports its state over the terminal's control plane. mtty badges the pane, raises a notification when an agent needs you, keeps the machine awake while one is working, and sends your queued prompt the moment it goes idle.",
    togetherFine:
      "Neither needs the other. Outside mtty the report is a no-op; with no agent reporting, mtty is simply a terminal. mtty also ships state hooks for other agent CLIs.",
    states: [
      ["api", "processing", "Working through the todo list"],
      ["web", "awaiting", "Asking permission to run a command"],
