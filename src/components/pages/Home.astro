---
// The home page, in both languages. The copy for each language sits side by
// side so a change to one is visibly a change to the other.
//
// The composition borrows from a couture house's gift selection: a centred,
// spaced-out uppercase masthead, one full-bleed campaign image, a grid of
// tiles with a name, a line and a "discover" link, and long stretches of white.
// Colour is left to the screenshots; the page itself is black on white.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import InstallCommand from "../site/InstallCommand.astro"
import ProductMedia from "../site/ProductMedia.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const RELEASES = "https://github.com/mttydev/mtty/releases/latest"

const copy = {
  en: {
    title: "miao — NOT only coding agent",
    description:
      "miao is an open-source terminal agent: it edits code, runs checks, researches, writes and runs long jobs. Context and cost stay visible every turn; install in one line.",
    kicker: "miao · open source",
    sloganNot: "NOT",
    sloganOnly: "only",
    sloganRest: "coding agent",
    heroLede:
      "Reads the repo, edits it, runs the checks. Researches, writes, runs long jobs, wakes on a schedule. Context and cost are visible every turn.",

    discover: "Discover miao",
    install: "Install",
    campaignAlt:
      "A real miao session inside mtty: a run of file edits shown as diffs, with sessions on the left and tokens, cost, context and todos on the right.",
    campaignCaption: "A real session · miao in mtty",
    selectionLabel: "The selection",
    selectionH: "What it does.",
    tiles: [
      ["/shots/miao.webp", "Code", "Reads the repo, edits in place, runs the checks, shows the diff.", "miao"],
      ["/shots/miao-providers.webp", "Your models", "Any provider. Tokens and cost per turn.", "miao"],
      ["/shots/miao-web.webp", "Beyond code", "Researches, reads images, drafts documents, runs long jobs, wakes on a schedule.", "miao"],
      ["/shots/mtty.webp", "mtty", "A Rust terminal and editor that knows when an agent needs you.", "mtty"],
    ],
    tileMore: "More",
    beyondLabel: "Beyond the code",
    beyondH: "One session, past the code.",
    beyondLede:
      "The session that fixes a test can then survey a site, compare designs or watch a terminal, and report back an hour later.",
    beyond: [
      ["Research", "Reads pages, papers and screenshots, and cites what it used."],
      ["Write", "Drafts documents, release notes and replies in your language."],
      ["Operate", "Runs background jobs and terminals, watches output, stops cleanly."],
      ["Remember", "Sessions, todos and notes survive restarts."],
    ],
    pillarsLabel: "How it's built",
    pillars: [
      ["Context", "A fixed baseline with changes appended in order. Caches keep hitting; compaction starts before the window fills."],
      ["Cost", "Tokens and cost per turn. Budgets by money, turns and time."],
      ["One binary", "No separate engine, no second TUI. macOS, Linux and Windows."],
    ],
    accountLabel: "Your account",
    accountH: "One account for miao and mtty.",
    accountLede:
      "Hosts, devices and preferences across machines. Accounts open soon.",
    signIn: "Sign in",
    signUp: "Create an account",
    endLabel: "Install",
    endH: "One line.",
    copyLabel: "Copy command",
    docs: "Read the docs",
    download: "Download mtty",
  },
  zh: {
    title: "miao — NOT only coding agent",
    description:
      "miao 是开源终端代理：改代码、跑检查，也能调研、写作、跑长任务。上下文与费用逐轮可见，一行安装。",
    kicker: "miao · 开源",
    sloganNot: "NOT",
    sloganOnly: "only",
    sloganRest: "coding agent",
    heroLede:
      "读仓库、改代码、跑检查；调研、写作、跑长任务、按计划醒来。上下文与费用逐轮可见。",

    discover: "了解 miao",
    install: "安装",
    campaignAlt: "mtty 里的真实 miao 会话：一串文件编辑以 diff 呈现，左侧是会话列表，右侧是 token、费用、上下文与待办。",
    campaignCaption: "真实会话 · mtty 中的 miao",
    selectionLabel: "精选",
    selectionH: "能做什么。",
    tiles: [
      ["/shots/miao.webp", "编码", "读仓库、改代码、跑检查，给出 diff。", "miao"],
      ["/shots/miao-providers.webp", "你的模型", "模型任选，token 与费用逐轮记录。", "miao"],
      ["/shots/miao-web.webp", "不止编码", "调研、读图、写文档、跑长任务、按计划醒来。", "miao"],
      ["/shots/mtty.webp", "mtty", "Rust 终端与编辑器，知道代理何时需要你。", "mtty"],
    ],
    tileMore: "了解更多",
    beyondLabel: "代码之外",
    beyondH: "同一个会话，接着做事。",
    beyondLede:
      "修完测试，同一个会话继续调研、比较设计、守着终端，按点回来汇报。",
    beyond: [
      ["调研", "读网页、论文和截图，注明依据。"],
      ["写作", "用你的语言写文档、发布说明和回复。"],
      ["运行", "跑后台任务和终端，盯住输出，干净停止。"],
      ["记忆", "会话、待办与笔记，重启后仍在。"],
    ],
    pillarsLabel: "实现",
    pillars: [
      ["上下文", "基线固定，变化按序追加；缓存持续命中，窗口填满前先压缩。"],
      ["费用", "每轮记录 token 与费用；预算按金额、轮次、时长。"],
      ["单一二进制", "没有额外引擎，没有第二套 TUI。macOS、Linux、Windows。"],
    ],
    accountLabel: "账户",
    accountH: "一个账户，通用 miao 与 mtty。",
    accountLede: "主机、设备、偏好跨机器同步。账户即将开放。",
    signIn: "登录",
    signUp: "注册账户",
    endLabel: "安装",
    endH: "一行命令。",
    copyLabel: "复制命令",
    docs: "阅读文档",
    download: "下载 mtty",
  },
}[lang]
---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="masthead">
    <p class="kicker rise" style="--i:0">{copy.kicker}</p>
    <h1 class="slogan" aria-label={`${copy.sloganNot} ${copy.sloganOnly} ${copy.sloganRest}`}>
      <span class="hl" style="--line:0" aria-hidden="true">
        <span><b>{copy.sloganNot}</b> <i>{copy.sloganOnly}</i></span>
      </span>
      <span class="hl" style="--line:1" aria-hidden="true"><span>{copy.sloganRest}</span></span>
    </h1>
    <p class="masthead-lede rise" style="--i:3">{copy.heroLede}</p>
    <div class="masthead-actions rise" style="--i:4">
      <a class="btn solid" href={`${prefix}/miao`}>{copy.discover}</a>
      <a class="btn" href="#install">{copy.install}</a>
    </div>
  </section>

  <figure class="campaign" data-reveal>

    <ProductMedia src="/shots/miao-mtty-session.webp" alt={copy.campaignAlt} eager sizes="100vw" />
    <figcaption>{copy.campaignCaption}</figcaption>
  </figure>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.selectionLabel}</p>
      <h2 class="chapter-title">{copy.selectionH}</h2>
    </header>
    <ul class="selection">
      {
        copy.tiles.map(([src, name, line, product]) => (
          <li>
            <a class="tile" href={`${prefix}/${product}`}>
              <span class="tile-media">
                <ProductMedia src={src} alt="" sizes="(max-width: 760px) 100vw, 25vw" />
              </span>
              <span class="tile-name">{name}</span>
              <span class="tile-line">{line}</span>
              <span class="tile-more">{copy.tileMore}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="beyond" data-reveal>
    <div class="wrap beyond-inner">
      <div class="beyond-copy">
        <p class="eyebrow">{copy.beyondLabel}</p>
        <h2 class="chapter-title beyond-title">{copy.beyondH}</h2>
        <p class="beyond-lede">{copy.beyondLede}</p>
      </div>
      <ol class="beyond-list">
        {
          copy.beyond.map(([head, body], index) => (
            <li>
              <span class="n">{String(index + 1).padStart(2, "0")}</span>
              <h3>{head}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.pillarsLabel}</p>
    </header>
    <ol class="pillars">
      {
        copy.pillars.map(([head, body]) => (
          <li>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap chapter account" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.accountLabel}</p>
      <h2 class="chapter-title">{copy.accountH}</h2>
      <p class="chapter-lede">{copy.accountLede}</p>
    </header>
    <div class="account-actions">
      <a class="btn solid" href={`${prefix}/account/sign-in`}>{copy.signIn}</a>
      <a class="btn" href={`${prefix}/account/sign-up`}>{copy.signUp}</a>
    </div>
  </section>

  <section class="wrap chapter end" id="install" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.endLabel}</p>
      <h2 class="chapter-title">{copy.endH}</h2>
    </header>
    <div class="end-install">
      <InstallCommand id="install-end" label={copy.copyLabel} />
    </div>
    <div class="end-links">
      <a class="link" href={`${prefix}/docs/`}>{copy.docs}</a>
      <a class="link" href={RELEASES}>{copy.download}</a>
    </div>
  </section>
</MarketingLayout>

<style>
  /* --- Masthead: the slogan, centred, in the house's spaced capitals ------- */

  .masthead {
    max-width: var(--maxw);
    margin-inline: auto;
    /* The first screen is the masthead alone: the campaign image must not
       peek above the fold. 60px is the shortest header at any breakpoint, so
       the hero is at least a full viewport tall after it. */
    min-height: calc(100svh - 60px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding: clamp(48px, 8vh, 96px) var(--gutter);
    text-align: center;
  }


  .kicker,
  .eyebrow {
    margin: 0 0 28px;
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .slogan {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 7.1rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }


  .slogan .hl {
    display: block;
    overflow: hidden;
    /* Room below for the serif's descender (the tail of "y"); the negative
       margin gives the space back so the line spacing does not change. */
    padding-block: 0.04em 0.24em;
    margin-bottom: -0.2em;
  }

  .slogan .hl > span {
    display: block;
    animation: line-in 1200ms var(--ease) both;
    animation-delay: calc(140ms + var(--line, 0) * 160ms);
  }

  /* "NOT" carries the weight; "only" drops into the display serif, lower case
     and italic, the way a couture headline sets its one soft word. */
  .slogan b {
    font-weight: 600;
    letter-spacing: 0.05em;
  }


  .slogan i {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  @keyframes line-in {
    from {
      transform: translateY(110%);
    }
  }

  .masthead-lede {
    max-width: 44ch;
    margin: 40px auto 0;
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    font-weight: 500;
    line-height: 1.65;
    word-break: keep-all;
  }


  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 44px;
  }

  /* --- Campaign image: full bleed, the one moment of colour ---------------- */

  .campaign {
    margin: 0;
    background: #0b0b0b;
  }

  /* The page's reveal is a pull-down: the campaign and every chapter start
     just above their resting place and settle down as they enter, so the
     first screen still stays type and buttons. */
  .campaign.reveal-pending,
  .chapter.reveal-pending,
  .beyond.reveal-pending {
    transform: translateY(-28px);
    transition:
      opacity 900ms var(--ease),
      transform 900ms var(--ease);
  }

  .campaign.reveal-pending.is-revealed,
  .chapter.reveal-pending.is-revealed,
  .beyond.reveal-pending.is-revealed {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .campaign.reveal-pending,
    .chapter.reveal-pending,
    .beyond.reveal-pending {
      transform: none;
    }
  }


  .campaign :global(.product-media) {
    width: min(100%, 1600px);
    margin-inline: auto;
  }

  .campaign figcaption {
    padding: 16px var(--gutter);
    background: var(--bg);
    color: var(--fg-faint);
    font-size: 0.66rem;
    font-weight: 550;
    letter-spacing: 0.24em;
    text-align: center;
    text-transform: uppercase;
  }

  /* --- Chapters ------------------------------------------------------------ */

  .chapter {
    padding-block: clamp(88px, 10vw, 136px);
  }

  .chapter-head {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .chapter-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .chapter-lede {
    max-width: 52ch;
    margin: 24px auto 0;
    color: var(--fg-muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  /* --- The selection: four tiles, a name, a line, a link ------------------- */

  .selection {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    gap: 10px;
    color: var(--fg);
    text-align: center;
    text-decoration: none;
  }

  .tile-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 14px;
    background: #0b0b0b;
  }

  /* The captures are landscape; show each one whole instead of cropping. */
  .tile-media :global(.product-media) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 900ms var(--ease);
  }

  .tile:hover .tile-media :global(.product-media) {
    transform: scale(1.035);
  }

  .tile-name {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .tile-line {
    max-width: 30ch;
    margin-inline: auto;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .tile-more,
  .link {
    justify-self: center;
    padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
    color: var(--fg);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .tile:hover .tile-more,
  .link:hover {
    color: var(--fg-muted);
  }

  /* --- Beyond the code: the one inverted band ----------------------------- */

  .beyond {
    background: #000;
    color: #fff;
  }

  .beyond-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(48px, 8vw, 120px);
    padding-block: clamp(96px, 11vw, 152px);
  }

  .beyond .eyebrow {
    color: #fff;
  }

  .beyond-title {
    white-space: pre-line;
    text-wrap: initial;
  }

  .beyond-lede {
    margin: 28px 0 0;
    color: rgb(255 255 255 / 0.66);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .beyond-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .beyond-list li {
    padding: 32px 28px 36px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  .beyond-list .n {
    color: rgb(255 255 255 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .beyond-list h3 {
    margin: 14px 0 10px;
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .beyond-list p {
    margin: 0;
    color: rgb(255 255 255 / 0.66);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* --- Essentials ---------------------------------------------------------- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--border);
  }

  .pillars li {
    padding: 44px 32px;
    text-align: center;
  }

  .pillars li + li {
    border-left: 1px solid var(--border);
  }

  .pillars h3 {
    margin: 0 0 16px;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .pillars p {
    max-width: 34ch;
    margin: 0 auto;
    color: var(--fg-muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  /* --- Account and install ------------------------------------------------- */

  .account {
    border-top: 1px solid var(--border);
  }

  .account-actions,
  .end-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 32px;
  }

  .account .chapter-head,
  .end .chapter-head {
    margin-bottom: 44px;
  }

  .end {
    border-top: 1px solid var(--border);
  }

  .end-install {
    max-width: 620px;
    margin: 0 auto 40px;
  }

  /* --- Motion -------------------------------------------------------------- */

  .rise {
    animation: rise 1100ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 110ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .slogan .hl > span {
      animation: none;
    }

    .tile-media :global(.product-media) {
      transition: none;
    }
  }

  /* --- Narrow screens ------------------------------------------------------ */

  @media (max-width: 1100px) {
    .selection {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .beyond-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .slogan {
      letter-spacing: 0.03em;
    }

    .selection {
      gap: 32px 14px;
    }

    .tile-line {
      font-size: 0.82rem;
    }

    .beyond-list,
    .pillars {
      grid-template-columns: 1fr;
    }

    .pillars li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .beyond-list li {
      padding-right: 0;
    }

    .masthead-actions :global(.btn),
    .account-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
