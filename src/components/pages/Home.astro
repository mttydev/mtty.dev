    shots: [
      ["/shots/miao-session.mp4", "miao · review, then choose a model", "An illustrative session shows the edit diff and context telemetry; model selection stays in the same conversation."],
      ["/shots/mtty-states.mp4", "mtty · agent state, live", "Control-plane events update the tab badge and Agent panel through processing, awaiting, error and idle."],
      ["/shots/miao-providers.mp4", "miao · bring your own provider", "Browse the provider picker and choose the service that fits your work."],
      ["/shots/mtty-editor.mp4", "mtty · editor and live preview", "A Markdown edit updates the adjacent preview, with Mermaid, tables and code blocks."],
      ["/shots/miao-web.mp4", "miao · the browser workspace", "Expand a code diff and open the review panel in the browser, using the same illustrative session."],
      ["/shots/mtty-review.mp4", "mtty · inline edit review", "Review a proposed change in the editor, then accept it through the command palette."],
      ["/shots/mtty-hosts.webp", "mtty · local and remote", "A grouped host library with file access and saved port forwards; all addresses shown are examples."],
      ["/shots/mtty-splits.webp", "mtty · recursive splits", "Git changes and a running local HTTP server side by side in the same workspace."],
    ],
    honestLabel: "status",
    honestH: "Before 1.0, with the limits named.",
    honest: [
      ["Pre-1.0", "Both projects ship often, and things change between versions. Release notes are on GitHub."],
      ["Docs from the source", "Both guides are synced from their repositories, and every page names the commit it came from."],
      ["Numbers with a caveat", "Benchmarks say what they measured. Opt-in and experimental features are marked as such."],
    ],
    endH: "Begin with one line.",
    docs: "Read the docs",
  },
  zh: {
    title: "miao — 终端里的开源编码代理",
    description:
      "miao 是开源的终端编码代理。它读仓库、改代码、跑检查，每一轮的改动和花费都摊开给你看。安装只有一行。",
    kicker: "开源的终端编码代理",
    h1a: "它读你的仓库，",
    h1b: "改你的代码，",
    h1c: "然后等你。",
    heroLede:
      "每一轮改了什么、花了多少，都看得见。装上它只要一行。",
    pillars: [
      [
        "上下文不堆东西",
        "系统上下文基线固定，变化按顺序追加，供应商的缓存能一直命中。窗口快满时先压缩，摘要接着当前请求往下写；旧工具输出默认裁掉。",
      ],
      [
        "花费看得见",
        "每一轮都记下 token、缓存命中和估算费用。预算按金额、token、轮次或时长来设，用到五分之四时提醒。",
      ],
      [
        "一行装好",
        "安装器只写一个二进制，没有额外的引擎或 TUI。macOS、Linux、Windows 都一样。",
      ],
    ],
    miaoBlurb: "读仓库、改代码、跑命令、验结果。模型你来选，每一轮都留底。",
    mttyBlurb: "Rust 写的终端与编辑器。终端、文件、远程主机和代理共用一个窗口，它知道代理是在干活、在等你，还是已经做完。",
    installHead: "安装 miao",
    installMeta: "macOS · Linux · Windows",
    downloadHead: "获取 mtty",
    download: "下载预览版",
    downloadMeta: "macOS · Linux · Windows · 预览版",
    copyLabel: "复制命令",
    shotMtty: "当前 mtty 示例工作区：会话侧栏、Markdown 编辑器、Mermaid 预览和分屏终端。",
    shotMiao: "当前 miao 示例会话：行内编辑 diff、回复和上下文用量。",
    capMtty: "mtty · 编辑、预览、终端和 Agent 状态",
    capMiao: "miao · 任务、改动、工具与上下文（示例会话）",
    productsLabel: "两个产品",
    productsH: "两个项目，各做各的。",
    miaoKind: "编码代理",
    miaoH: "先把上下文管好。",
    miaoPoints: [
      ["上下文不堆东西", "系统上下文基线不动，变化按时间顺序追加，供应商跨轮都能命中提示缓存。"],
      ["快满了就先压缩", "压缩在窗口填满前开始，摘要复用当前请求前缀；旧工具输出默认裁掉，完整结果留在磁盘。"],
      ["每一轮都记账", "逐轮 token、缓存命中率、首 token 延迟和估算费用，都能查。预算按金额、token、轮次和时长设。"],
      ["一行就够", "安装器只写 miao，不带引擎或 TUI。同一条命令覆盖 macOS、Linux 和 Windows。"],
    ],
    miaoMeta: "单二进制 · Rust 加速 · MIT",
    miaoMore: "了解 miao",
    mttyKind: "终端 · 编辑器 · 代理",
    mttyH: "终端、编辑器、代理，一个窗口。",
    mttyPoints: [
      ["GPU 渲染", "只重绘变化的部分，性能有实测预算。"],
      ["它是个工作台", "标签、递归分屏、快速打开文件，还有带高亮、LSP 和实时预览的编辑器窗格。"],
      ["它看得懂代理", "窗格徽章、系统通知、防休眠和提示队列，都跟着代理状态走。"],
      ["远程主机，像本地目录", "主机库、密钥、SFTP、端口转发、跳板机和片段，走你自己的 OpenSSH。"],
    ],
    mttyMeta: "Rust · Apache-2.0 · 预发布",
    mttyMore: "了解 mtty",
    togetherLabel: "配合使用",
    togetherH: "四个代理跑着，你不用一个个盯。",
    togetherLede:
      "miao 在 mtty 的窗格里干活时，会通过终端的控制面报告状态。mtty 给窗格加徽章，代理需要你时发通知，干活时让电脑别睡，一空闲就把排队的提示发出去。",
    togetherFine:
      "两个项目谁也不依赖谁。不在 mtty 里，状态上报什么也不做；没有代理上报，mtty 就是个普通终端。它也带其他代理 CLI 的状态钩子。",
    states: [
      ["api", "processing", "正在推进待办清单"],
      ["web", "awaiting", "请求执行命令的权限"],
      ["docs", "idle", "做完了，下一条排队提示接着发。"],
      ["migrate", "error", "模型服务返回了错误"],
    ],
    illus: "示意：mtty 能识别的四种代理状态",
    flow: ["miao", "代理状态", "mtty 窗格"],
    shotsLabel: "看图",
    shotsH: "实际用起来是这样。",
    shots: [
      ["/shots/miao-session.mp4", "miao · 审阅改动，再选模型", "示例会话展示编辑 diff 和上下文用量；模型选择也留在同一个会话中。"],
      ["/shots/mtty-states.mp4", "mtty · 代理状态，实时变化", "控制面事件让标签徽章和 Agent 面板依次显示 processing、awaiting、error 与 idle。"],
      ["/shots/miao-providers.mp4", "miao · 自带模型服务商", "打开供应商选择器，浏览并选择适合任务的服务。"],
      ["/shots/mtty-editor.mp4", "mtty · 编辑器与实时预览", "Markdown 改动同步更新旁边的预览，包含 Mermaid、表格与代码块。"],
      ["/shots/miao-web.mp4", "miao · 浏览器工作区", "在浏览器里展开代码 diff、打开审阅面板，使用同一个示例会话。"],
      ["/shots/mtty-review.mp4", "mtty · 行内改动审阅", "在编辑器里审阅拟议改动，再通过命令面板接受。"],
      ["/shots/mtty-hosts.webp", "mtty · 本地与远程", "分组主机库提供文件入口和已保存的端口转发；地址都是示例。"],
      ["/shots/mtty-splits.webp", "mtty · 递归分屏", "Git 改动与实际运行的本地 HTTP 服务并排，共用一个工作区。"],
    ],
    honestLabel: "现状",
    honestH: "还在 1.0 之前。哪里不稳，写清楚。",
    honest: [
      ["1.0 之前", "两个项目都发得很勤，版本之间会有变化。发布说明在 GitHub。"],
      ["文档跟着源码走", "两个产品的手册都从各自仓库同步，每页标了来源提交。"],
      ["数字有出处", "基准测试写明测的是什么；可选和实验性的功能都会标出来。"],
    ],
    endH: "从一行命令开始。",
    docs: "阅读文档",
  },
}[lang]
---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="wrap hero-head">
      <div class="hero-topline rise">
        <span><MiaoMark size={15} /> miao</span>
        <span>{copy.kicker}</span>
        <span>OPEN SOURCE · MIT</span>
      </div>

      <h1 class="display h1">
        <span class="hl" style="--line:0"><span>{copy.h1a}</span></span>
        <span class="hl" style="--line:1"><span>{copy.h1b}</span></span>
        <em class="hl accent" style="--line:2"><span>{copy.h1c}</span></em>
      </h1>

      <div class="hero-intro rise" style="--i:2">
        <p class="lede">{copy.heroLede}</p>
        <div class="hero-install">
          <p class="install-caption">{copy.installHead} · {copy.installMeta}</p>
          <InstallCommand id="install-hero" label={copy.copyLabel} />
        </div>
      </div>
    </div>

    <ol class="wrap hero-features rise" style="--i:3">
      {
        copy.pillars.map(([head, body], index) => (
          <li>
            <span class="n">0{index + 1}</span>
            <h2 class="pillar-head">{head}</h2>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>

    <div class="hero-stage rise" style="--i:4">
      <ProductShowcase lang={lang} miaoKind={copy.miaoKind} mttyKind={copy.mttyKind}>
          <ShowcaseWindow slot="miao" embedded product="miao" kind={copy.miaoKind} lang={lang} slides={[
            { src: "/shots/miao.webp", label: lang === "zh" ? "行内代码改动与上下文用量 · 示例会话" : "Inline code changes and context usage · Example session", alt: copy.shotMiao },
            { src: "/shots/miao-providers.webp", label: lang === "zh" ? "连接你选择的模型服务" : "Connect your choice of model provider", alt: lang === "zh" ? "miao 模型服务选择面板" : "miao model provider selection" },
            { src: "/shots/miao-home.webp", label: lang === "zh" ? "从一个提示开始" : "Start with a prompt", alt: lang === "zh" ? "miao 启动界面和提示输入框" : "miao start screen and prompt input" },
          ]} />
          <ShowcaseWindow slot="mtty" embedded product="mtty" kind={copy.mttyKind} lang={lang} slides={[
            { src: "/shots/mtty.webp", label: lang === "zh" ? "编辑器、预览与终端" : "Editor, preview and terminal", alt: copy.shotMtty },
            { src: "/shots/mtty-editor.webp", label: lang === "zh" ? "Markdown 与 Mermaid 实时预览" : "Live Markdown and Mermaid preview", alt: lang === "zh" ? "mtty Markdown 编辑器和实时预览" : "mtty Markdown editor with live preview" },
            { src: "/shots/mtty-splits.webp", label: lang === "zh" ? "并排查看终端与运行中的服务" : "Terminals and running services side by side", alt: lang === "zh" ? "mtty 递归分屏终端" : "mtty split terminals" },
          ]} />
      </ProductShowcase>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>01</b> {copy.productsLabel}</p>
      <h2 class="display h2">{copy.productsH}</h2>
    </div>
    <div class="duo">
      <a class="card c-miao" href={`${prefix}/miao`}>
        <div class="card-top">
          <MiaoMark size={40} />
          <div>
            <span class="card-name">miao</span>
            <span class="card-kind">{copy.miaoKind}</span>
          </div>
        </div>
        <h3 class="display h3">{copy.miaoH}</h3>
        <dl class="points">
          {
            copy.miaoPoints.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="card-foot">
          <span class="card-meta">{copy.miaoMeta}</span>
          <span class="more">{copy.miaoMore} <span class="arrow">→</span></span>
        </div>
      </a>
      <a class="card c-mtty" href={`${prefix}/mtty`}>
        <div class="card-top">
          <MttyMark size={40} />
          <div>
            <span class="card-name">mtty</span>
            <span class="card-kind">{copy.mttyKind}</span>
          </div>
        </div>
        <h3 class="display h3">{copy.mttyH}</h3>
        <dl class="points">
          {
            copy.mttyPoints.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="card-foot">
          <span class="card-meta">{copy.mttyMeta}</span>
          <span class="more">{copy.mttyMore} <span class="arrow">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <section class="wrap section together" data-reveal>
    <div class="together-copy">
      <p class="label"><b>02</b> {copy.togetherLabel}</p>
      <h2 class="display h2">{copy.togetherH}</h2>
      <p class="lede">{copy.togetherLede}</p>
      <p class="fine">{copy.togetherFine}</p>
    </div>
    <div class="board panel" role="img" aria-label={copy.illus}>
      <div class="board-bar" aria-hidden="true">
        <MttyMark size={16} />
        <span>mtty</span>
      </div>
      <ul class="panes" aria-hidden="true">
        {
          copy.states.map(([name, state, note]) => (
            <li data-state={state}>
              <span class="badge" />
              <span class="pane-name">{name}</span>
              <span class="pane-state">{state}</span>
              <span class="pane-note">{note}</span>
            </li>
          ))
        }
      </ul>
      <div class="wire" aria-hidden="true">
        <span class="node n-miao">{copy.flow[0]}</span>
        <span class="line"><span class="pulse"></span></span>
        <span class="node">{copy.flow[1]}</span>
        <span class="line"><span class="pulse"></span></span>
        <span class="node n-mtty">{copy.flow[2]}</span>
      </div>
      <code class="board-cmd" aria-hidden="true"
        >mtty-cli state miao --state awaiting --pane $MTTY_PANE_ID</code
      >
    </div>
  </section>

  <section class="wrap section shots" data-reveal>
    <div class="section-head">
      <p class="label"><b>03</b> {copy.shotsLabel}</p>
      <h2 class="display h2">{copy.shotsH}</h2>
    </div>
    <div class="shotgrid">
      {
        copy.shots.map(([src, head, body]) => (
          <figure class="scard">
            <ProductMedia src={src} alt={body} />
            <figcaption>
              <b>{head}</b>
              <span>{body}</span>
              <a class="media-original" href={src} target="_blank" rel="noopener noreferrer">{lang === "zh" ? "放大查看" : "View full size"} ↗</a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>04</b> {copy.honestLabel}</p>
      <h2 class="display h2">{copy.honestH}</h2>
    </div>
    <ol class="honest">
      {
        copy.honest.map(([head, body], index) => (
          <li>
            <span class="n">0{index + 1}</span>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section end" data-reveal>
    <h2 class="display h2">{copy.endH}</h2>
    <InstallCommand id="install-end" label={copy.copyLabel} />
    <div class="actions">
      <a class="btn" href={`${prefix}/docs/`}>{copy.docs} <span class="arrow">→</span></a>
      <a class="btn" href={RELEASES}>{copy.download} <span class="arrow">→</span></a>
    </div>
  </section>
</MarketingLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: 56px;
  }

  .g1 {
    width: 720px;
    height: 520px;
    left: -180px;
    top: -200px;
    background: var(--miao-1);
  }

  .g2 {
    width: 680px;
    height: 520px;
    right: -220px;
    top: 380px;
    background: var(--mtty-accent);
  }

  /* Keep the introduction, actions and both workspaces together above the fold. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: 48px;
    align-items: center;
    padding-bottom: 8px;
  }

  .h1 {
    margin-top: 4px;
    font-size: clamp(2.1rem, 3.1vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
  }

  .h1 .hl {
    display: block;
  }

  :lang(zh-CN) .h1 {
    font-size: clamp(1.9rem, 2.9vw, 2.7rem);
    line-height: 1.28;
  }

  .picks {
    display: grid;
    gap: 28px;
    margin-top: 36px;
  }

  .pick {
    display: grid;
    gap: 10px;
    min-width: 0;
    padding-top: 18px;
    border-top: 1px solid var(--border-strong);
  }

  .pick-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0;
