---
// The home page, in both languages. The copy for each language sits side by
// side so a change to one is visibly a change to the other.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import InstallCommand from "../site/InstallCommand.astro"
import MiaoMark from "../site/MiaoMark.astro"
import MttyMark from "../site/MttyMark.astro"
import ShowcaseWindow from "../site/ShowcaseWindow.astro"
import ProductShowcase from "../site/ProductShowcase.astro"
import ProductMedia from "../site/ProductMedia.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const RELEASES = "https://github.com/mttydev/mtty/releases/latest"

const copy = {
  en: {
    title: "miao — designed for focus",
    description:
      "miao is an open-source AI agent for the terminal: a leaner context, a transparent bill, and a one-line install.",
    kicker: "An open-source AI agent for the terminal",
    h1a: "Less noise.",
    h1b: "More composure.",
    h1c: "One line to begin.",
    heroLede:
      "Designed for focus. Context keeps only what matters, every turn's cost stays visible, and installation is a single command.",
    pillars: [
      [
        "Context, only what matters",
        "A stable system-context baseline keeps provider caches reusable. Compaction begins before the window fills and reuses the current request prefix; old tool output is pruned by default.",
