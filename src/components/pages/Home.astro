---
// The home page, in both languages. The copy for each language sits side by
// side so a change to one is visibly a change to the other.
//
// The composition borrows from a couture house's gift selection: a centred,
// spaced-out uppercase masthead, one full-bleed campaign image, a grid of
// tiles with a name, a line and a "discover" link, and long stretches of white.
// Colour is left to the screenshots; the page itself is black on white.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import InstallCommand from "../site/InstallCommand.astro"
import ProductMedia from "../site/ProductMedia.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const RELEASES = "https://github.com/mttydev/mtty/releases/latest"

const copy = {
  en: {
    title: "miao — NOT only coding agent",
    description:
      "miao is an open-source agent for the terminal that codes — and researches, writes, runs jobs and keeps its own schedule. Visible context and cost, one-line install.",
    kicker: "miao · open source",
    sloganNot: "NOT",
    sloganOnly: "only",
    sloganRest: "coding agent",
    heroLede:
      "It reads the repo and ships the change. It also researches, writes, runs long jobs, watches a terminal and keeps its own schedule — with context and cost visible every turn.",
    discover: "Discover miao",
    install: "Install",
    campaignAlt:
      "A real miao session inside mtty: a run of file edits shown as diffs, with sessions on the left and tokens, cost, context and todos on the right.",
    campaignCaption: "A real session · miao in mtty",
    selectionLabel: "The selection",
    selectionH: "One agent, many hands.",
    tiles: [
      ["/shots/miao.webp", "Code", "Reads the repository, edits in place, runs the checks and shows the diff.", "miao"],
      ["/shots/miao-providers.webp", "Your models", "Any provider you choose. Tokens, cache and cost are recorded per turn.", "miao"],
      ["/shots/miao-web.webp", "Beyond code", "Research the web, read images, draft documents, run jobs and wake itself on a schedule.", "miao"],
      ["/shots/mtty.webp", "mtty", "A terminal and editor in Rust that knows when an agent needs you.", "mtty"],
    ],
    tileMore: "Discover",
    beyondLabel: "Beyond the code",
    beyondH: "Not only code. Still only what you ask.",
    beyondLede:
      "A coding agent is where miao starts, not where it stops. The same session that fixes a test can survey a site, compare two designs, keep a terminal alive and report back an hour later.",
    beyond: [
      ["Research", "Fetches and reads pages, papers and screenshots, and cites what it used."],
      ["Write", "Drafts documents, release notes and replies in your language."],
      ["Operate", "Starts background jobs and terminals, watches their output and stops them cleanly."],
      ["Remember", "Durable sessions, todo lists and notes survive restarts and compaction."],
    ],
    pillarsLabel: "The essentials",
    pillars: [
      ["Context", "A fixed baseline with changes appended in order. Caches keep hitting; compaction starts before the window fills."],
      ["Cost", "Tokens, cache and estimated cost per turn. Budgets by money, turns and time."],
      ["One binary", "No separate engine, no second TUI. macOS, Linux and Windows."],
    ],
    accountLabel: "Your account",
    accountH: "One account for miao and mtty.",
    accountLede:
      "Sign in to carry your hosts, devices and preferences between machines. Accounts are opening soon; the pages are ready.",
    signIn: "Sign in",
    signUp: "Create an account",
    endLabel: "Begin",
    endH: "Begin with one line.",
    copyLabel: "Copy command",
    docs: "Read the docs",
    download: "Download mtty",
  },
  zh: {
    title: "miao — NOT only coding agent",
    description:
      "miao 是开源的终端代理：会写代码，也会调研、写作、跑任务、按计划自己醒来。上下文与费用逐轮可见，一行安装。",
    kicker: "miao · 开源",
    sloganNot: "NOT",
    sloganOnly: "only",
    sloganRest: "coding agent",
    heroLede:
      "读仓库、改代码、跑检查；也调研、写作、运行长任务、看守终端、按计划行事。上下文与费用，逐轮可见。",
    discover: "了解 miao",
    install: "安装",
    campaignAlt: "mtty 里的真实 miao 会话：一串文件编辑以 diff 呈现，左侧是会话列表，右侧是 token、费用、上下文与待办。",
    campaignCaption: "真实会话 · mtty 中的 miao",
    selectionLabel: "精选",
    selectionH: "一个代理，多种能力。",
    tiles: [
      ["/shots/miao.webp", "编码", "读仓库、就地修改、跑检查，并给出 diff。", "miao"],
      ["/shots/miao-providers.webp", "你的模型", "模型服务任你选择。token、缓存与费用逐轮记录。", "miao"],
      ["/shots/miao-web.webp", "不止编码", "上网调研、读图、起草文档、运行任务，并按计划自己醒来。", "miao"],
      ["/shots/mtty.webp", "mtty", "Rust 编写的终端与编辑器，知道代理何时需要你。", "mtty"],
    ],
    tileMore: "了解更多",
    beyondLabel: "不止于代码",
    beyondH: "不止写代码，\n只做你交代的事。",
    beyondLede:
      "编码是 miao 的起点，而不是终点。修好测试的同一个会话，也能调研一个网站、比较两版设计、守着一个终端，一小时后再来汇报。",
    beyond: [
      ["调研", "抓取并阅读网页、论文与截图，并注明依据。"],
      ["写作", "用你的语言起草文档、发布说明与回复。"],
      ["运行", "启动后台任务与终端，盯住输出，干净地停止。"],
      ["记忆", "会话、待办与笔记持久保存，重启与压缩后仍在。"],
    ],
    pillarsLabel: "基本功",
    pillars: [
      ["上下文", "固定基线，变化按序追加。缓存持续命中，压缩在窗口填满之前发生。"],
      ["费用", "token、缓存与估算费用逐轮记录。预算按金额、轮次与时长设定。"],
      ["单一二进制", "没有额外引擎，没有第二套 TUI。macOS、Linux、Windows。"],
    ],
    accountLabel: "账户",
    accountH: "一个账户，通用 miao 与 mtty。",
    accountLede: "登录后，主机、设备与偏好在不同机器间同步。账户即将开放，页面已经就绪。",
    signIn: "登录",
    signUp: "注册账户",
    endLabel: "开始",
    endH: "从一行命令开始。",
    copyLabel: "复制命令",
    docs: "阅读文档",
    download: "下载 mtty",
  },
}[lang]
---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="masthead">
    <p class="kicker rise" style="--i:0">{copy.kicker}</p>
    <h1 class="slogan" aria-label={`${copy.sloganNot} ${copy.sloganOnly} ${copy.sloganRest}`}>
      <span class="hl" style="--line:0" aria-hidden="true">
        <span><b>{copy.sloganNot}</b> <i>{copy.sloganOnly}</i></span>
      </span>
      <span class="hl" style="--line:1" aria-hidden="true"><span>{copy.sloganRest}</span></span>
    </h1>
    <p class="masthead-lede rise" style="--i:3">{copy.heroLede}</p>
    <div class="masthead-actions rise" style="--i:4">
      <a class="btn solid" href={`${prefix}/miao`}>{copy.discover}</a>
      <a class="btn" href="#install">{copy.install}</a>
    </div>
  </section>

  <figure class="campaign rise" style="--i:5">
    <ProductMedia src="/shots/miao-mtty-session.webp" alt={copy.campaignAlt} eager sizes="100vw" />
    <figcaption>{copy.campaignCaption}</figcaption>
  </figure>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.selectionLabel}</p>
      <h2 class="chapter-title">{copy.selectionH}</h2>
    </header>
    <ul class="selection">
      {
        copy.tiles.map(([src, name, line, product]) => (
          <li>
            <a class="tile" href={`${prefix}/${product}`}>
              <span class="tile-media">
                <ProductMedia src={src} alt="" sizes="(max-width: 760px) 100vw, 25vw" />
              </span>
              <span class="tile-name">{name}</span>
              <span class="tile-line">{line}</span>
              <span class="tile-more">{copy.tileMore}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="beyond" data-reveal>
    <div class="wrap beyond-inner">
      <div class="beyond-copy">
        <p class="eyebrow">{copy.beyondLabel}</p>
        <h2 class="chapter-title beyond-title">{copy.beyondH}</h2>
        <p class="beyond-lede">{copy.beyondLede}</p>
      </div>
      <ol class="beyond-list">
        {
          copy.beyond.map(([head, body], index) => (
            <li>
              <span class="n">{String(index + 1).padStart(2, "0")}</span>
              <h3>{head}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="wrap chapter" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.pillarsLabel}</p>
    </header>
    <ol class="pillars">
      {
        copy.pillars.map(([head, body]) => (
          <li>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap chapter account" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.accountLabel}</p>
      <h2 class="chapter-title">{copy.accountH}</h2>
      <p class="chapter-lede">{copy.accountLede}</p>
    </header>
    <div class="account-actions">
      <a class="btn solid" href={`${prefix}/account/sign-in`}>{copy.signIn}</a>
      <a class="btn" href={`${prefix}/account/sign-up`}>{copy.signUp}</a>
    </div>
  </section>

  <section class="wrap chapter end" id="install" data-reveal>
    <header class="chapter-head">
      <p class="eyebrow">{copy.endLabel}</p>
      <h2 class="chapter-title">{copy.endH}</h2>
    </header>
    <div class="end-install">
      <InstallCommand id="install-end" label={copy.copyLabel} />
    </div>
    <div class="end-links">
      <a class="link" href={`${prefix}/docs/`}>{copy.docs}</a>
      <a class="link" href={RELEASES}>{copy.download}</a>
    </div>
  </section>
</MarketingLayout>

<style>
  /* --- Masthead: the slogan, centred, in the house's spaced capitals ------- */

  .masthead {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: clamp(72px, 11vw, 148px) var(--gutter) clamp(56px, 7vw, 96px);
    text-align: center;
  }

  .kicker,
  .eyebrow {
    margin: 0 0 28px;
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .slogan {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 8.2vw, 7.4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .slogan .hl {
    display: block;
    overflow: hidden;
    /* Room below for the serif's descender (the tail of "y"); the negative
       margin gives the space back so the line spacing does not change. */
    padding-block: 0.04em 0.24em;
    margin-bottom: -0.2em;
  }

  .slogan .hl > span {
    display: block;
    animation: line-in 1200ms var(--ease) both;
    animation-delay: calc(140ms + var(--line, 0) * 160ms);
  }

  /* "NOT" carries the weight; "only" drops into the display serif, lower case
     and italic, the way a couture headline sets its one soft word. */
  .slogan b {
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .slogan i {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  @keyframes line-in {
    from {
      transform: translateY(110%);
    }
  }

  .masthead-lede {
    max-width: 46ch;
    margin: 40px auto 0;
    color: var(--fg-muted);
    font-size: clamp(1.02rem, 1.3vw, 1.18rem);
    line-height: 1.8;
  }

  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 44px;
  }

  /* --- Campaign image: full bleed, the one moment of colour ---------------- */

  .campaign {
    margin: 0;
    background: #0b0b0b;
  }

  .campaign :global(.product-media) {
    width: min(100%, 1600px);
    margin-inline: auto;
  }

  .campaign figcaption {
    padding: 16px var(--gutter);
    background: var(--bg);
    color: var(--fg-faint);
    font-size: 0.66rem;
    font-weight: 550;
    letter-spacing: 0.24em;
    text-align: center;
    text-transform: uppercase;
  }

  /* --- Chapters ------------------------------------------------------------ */

  .chapter {
    padding-block: clamp(88px, 10vw, 136px);
  }

  .chapter-head {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .chapter-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .chapter-lede {
    max-width: 52ch;
    margin: 24px auto 0;
    color: var(--fg-muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  /* --- The selection: four tiles, a name, a line, a link ------------------- */

  .selection {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    gap: 10px;
    color: var(--fg);
    text-align: center;
    text-decoration: none;
  }

  .tile-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 14px;
    background: #0b0b0b;
  }

  /* The captures are landscape; show each one whole instead of cropping. */
  .tile-media :global(.product-media) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 900ms var(--ease);
  }

  .tile:hover .tile-media :global(.product-media) {
    transform: scale(1.035);
  }

  .tile-name {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .tile-line {
    max-width: 30ch;
    margin-inline: auto;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .tile-more,
  .link {
    justify-self: center;
    padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
    color: var(--fg);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .tile:hover .tile-more,
  .link:hover {
    color: var(--fg-muted);
  }

  /* --- Beyond the code: the one inverted band ----------------------------- */

  .beyond {
    background: #000;
    color: #fff;
  }

  .beyond-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(48px, 8vw, 120px);
    padding-block: clamp(96px, 11vw, 152px);
  }

  .beyond .eyebrow {
    color: #fff;
  }

  .beyond-title {
    white-space: pre-line;
    text-wrap: initial;
  }

  .beyond-lede {
    margin: 28px 0 0;
    color: rgb(255 255 255 / 0.66);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .beyond-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .beyond-list li {
    padding: 32px 28px 36px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  .beyond-list .n {
    color: rgb(255 255 255 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .beyond-list h3 {
    margin: 14px 0 10px;
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .beyond-list p {
    margin: 0;
    color: rgb(255 255 255 / 0.66);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* --- Essentials ---------------------------------------------------------- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--border);
  }

  .pillars li {
    padding: 44px 32px;
    text-align: center;
  }

  .pillars li + li {
    border-left: 1px solid var(--border);
  }

  .pillars h3 {
    margin: 0 0 16px;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .pillars p {
    max-width: 34ch;
    margin: 0 auto;
    color: var(--fg-muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  /* --- Account and install ------------------------------------------------- */

  .account {
    border-top: 1px solid var(--border);
  }

  .account-actions,
  .end-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 32px;
  }

  .account .chapter-head,
  .end .chapter-head {
    margin-bottom: 44px;
  }

  .end {
    border-top: 1px solid var(--border);
  }

  .end-install {
    max-width: 620px;
    margin: 0 auto 40px;
  }

  /* --- Motion -------------------------------------------------------------- */

  .rise {
    animation: rise 1100ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 110ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .slogan .hl > span {
      animation: none;
    }

    .tile-media :global(.product-media) {
      transition: none;
    }
  }

  /* --- Narrow screens ------------------------------------------------------ */

  @media (max-width: 1100px) {
    .selection {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .beyond-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .slogan {
      letter-spacing: 0.03em;
    }

    .selection {
      gap: 32px 14px;
    }

    .tile-line {
      font-size: 0.82rem;
    }

    .beyond-list,
    .pillars {
      grid-template-columns: 1fr;
    }

    .pillars li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .beyond-list li {
      padding-right: 0;
    }

    .masthead-actions :global(.btn),
    .account-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
