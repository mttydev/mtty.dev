      ["migrate", "error", "The provider returned an error"],
    ],
    illus: "Illustration of the four states mtty understands",
    flow: ["miao", "agent state", "mtty pane"],
    shotsLabel: "in pictures",
    shotsH: "Terminals, editor and agents in one window.",
    shots: [
      ["/shots/miao-session.mp4", "miao · review, then choose a model", "An illustrative session shows the edit diff and context telemetry; model selection stays in the same conversation."],
      ["/shots/mtty-states.mp4", "mtty · agent state, live", "Control-plane events update the tab badge and Agent panel through processing, awaiting, error and idle."],
      ["/shots/miao-providers.mp4", "miao · bring your own provider", "Browse the provider picker and choose the service that fits your work."],
      ["/shots/mtty-editor.mp4", "mtty · editor and live preview", "A Markdown edit updates the adjacent preview, with Mermaid, tables and code blocks."],
      ["/shots/miao-web.mp4", "miao · the browser workspace", "Expand a code diff and open the review panel in the browser, using the same illustrative session."],
      ["/shots/mtty-review.mp4", "mtty · inline edit review", "Review a proposed change in the editor, then accept it through the command palette."],
      ["/shots/mtty-hosts.webp", "mtty · local and remote", "A grouped host library with file access and saved port forwards; all addresses shown are examples."],
      ["/shots/mtty-splits.webp", "mtty · recursive splits", "Git changes and a running local HTTP server side by side in the same workspace."],
    ],
    honestLabel: "status",
    honestH: "Early, but clear about its limits.",
    honest: [
      ["Pre-1.0", "Both projects release often and change between versions. Release notes live on GitHub."],
      ["Docs from the source", "User guides for both products are synced from their repositories; each synced page names its source commit."],
      ["Claims with caveats", "Benchmarks say what they measure. Features that are opt-in or experimental say so."],
    ],
    endH: "Begin with one line.",
    docs: "Read the docs",
  },
  zh: {
    title: "miao — 为专注而设计",
    description:
      "miao 是终端中的开源 AI 智能体。上下文精简，开销透明，安装只需一行。",
    kicker: "终端中的开源 AI 智能体",
    h1a: "少一点冗余。",
    h1b: "多一点从容。",
    h1c: "一行，即可开始。",
    heroLede:
      "为专注而设计。上下文只保留必要部分，每一轮开销清晰可查；安装只需一行命令。",
    pillars: [
      [
        "上下文，只留必要",
        "稳定的系统上下文基线让供应商缓存持续复用。压缩在窗口填满之前开始，摘要复用当前请求前缀；旧工具输出默认裁剪。",
      ],
      [
        "开销，始终可见",
        "逐轮 token、缓存命中与估算费用均有记录。预算可按金额、token、模型轮次与实际耗时设定，使用至五分之四时提醒。",
      ],
